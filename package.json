{
  "name": "ekko-agent-server",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=23.0.0"
  },
  "scripts": {
    "dev": "nodemon --watch server/src --ext ts --exec ts-node server/src/index.ts",
    "start": "node server/dist/index.js",
    "build": "tsc -p server/tsconfig.json",
    "typecheck": "tsc -p server/tsconfig.json --noEmit",
    "test:agent-openai": "ts-node --project tsconfig.json test/agent-code-openai.ts"
  },
  "dependencies": {
    "@koa/bodyparser": "^6.1.0",
    "@koa/router": "^15.5.0",
    "koa": "^2.16.4",
    "openai": "^6.36.0"
  },
  "devDependencies": {
    "@types/koa": "^2.15.0",
    "@types/koa__router": "^12.0.5",
    "@types/node": "^25.6.0",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
